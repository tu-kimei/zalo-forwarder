datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

generator client {
  provider = "prisma-client-js"
}

// ─── Zalo Account / Session ──────────────────────────────────────────────────

model ZaloAccount {
  id            String        @id @default(uuid())
  accountId     String?       @unique       // Zalo UID
  displayName   String?
  avatar        String?
  phoneNumber   String?

  // Session data
  cookies       Json?                       // Multi-domain cookies (JSON array)
  imei          String?
  userAgent     String        @default("Mozilla/5.0 (Windows NT 10.0; Win64; x64) AppleWebKit/537.36 (KHTML, like Gecko) Chrome/120.0.0.0 Safari/537.36")
  zpwEnk        String?                     // AES key (Base64)
  loginInfo     Json?

  // Status
  status        AccountStatus @default(DRAFT)
  lastHealthCheck DateTime?
  lastMessageAt DateTime?

  // Timestamps
  createdAt     DateTime      @default(now())
  updatedAt     DateTime      @updatedAt

  // Relations
  messages      ZaloMessage[]
  webhookLogs   WebhookLog[]

  @@index([status])
}

enum AccountStatus {
  DRAFT
  QR_GENERATED
  SCANNED
  CONFIRMED
  ACTIVE
  INACTIVE
  ERROR
}

// ─── Received Messages ───────────────────────────────────────────────────────

model ZaloMessage {
  id            String        @id @default(uuid())
  zaloMsgId     String        @unique       // Zalo internal msg ID
  accountId     String

  // Group info
  groupId       String?
  groupName     String?

  // Sender info
  senderId      String
  senderName    String?

  // Content
  type          MessageType   @default(TEXT)
  text          String?
  images        String[]      @default([])  // URLs
  rawData       Json?

  // Processing
  forwarded     Boolean       @default(false)
  forwardedAt   DateTime?

  createdAt     DateTime      @default(now())

  account            ZaloAccount      @relation(fields: [accountId], references: [id])
  webhookLogs        WebhookLog[]
  imageAttachments   ImageAttachment[]
  ocrResults         OcrResult[]

  @@index([groupId, createdAt])
  @@index([forwarded])
}

enum MessageType {
  TEXT
  IMAGE
  FILE
  STICKER
  UNKNOWN
}

// ─── Webhook Configuration ───────────────────────────────────────────────────

model WebhookConfig {
  id            String        @id @default(uuid())
  name          String
  url           String
  secret        String?                     // HMAC signing secret
  events        String[]      @default(["message"])
  groupFilter   String[]      @default([])  // Empty = all groups
  active        Boolean       @default(true)

  createdAt     DateTime      @default(now())
  updatedAt     DateTime      @updatedAt

  logs          WebhookLog[]
}

// ─── Webhook Delivery Logs ───────────────────────────────────────────────────

model WebhookLog {
  id            String        @id @default(uuid())
  webhookId     String
  messageId     String?
  accountId     String?

  // Request
  payload       Json

  // Response
  statusCode    Int?
  response      String?

  // Retry
  attempt       Int           @default(1)
  success       Boolean       @default(false)
  error         String?

  createdAt     DateTime      @default(now())

  webhook       WebhookConfig @relation(fields: [webhookId], references: [id])
  message       ZaloMessage?  @relation(fields: [messageId], references: [id])
  account       ZaloAccount?  @relation(fields: [accountId], references: [id])

  @@index([webhookId, createdAt])
  @@index([success])
}

// ─── Group Configuration ─────────────────────────────────────────────────────

model GroupConfig {
  id            String        @id @default(uuid())
  groupId       String        @unique
  groupName     String?
  category      String?                     // "fuel", "repair", etc.
  active        Boolean       @default(true)

  createdAt     DateTime      @default(now())
  updatedAt     DateTime      @updatedAt
}

// ─── Image Storage ───────────────────────────────────────────────────────────

model ImageAttachment {
  id            String    @id @default(uuid())
  messageId     String
  originalUrl   String                    // Zalo CDN URL
  localPath     String?                   // Local file path after download
  fileName      String?
  mimeType      String?
  fileSize      Int?
  downloaded    Boolean   @default(false)
  downloadError String?
  createdAt     DateTime  @default(now())

  message       ZaloMessage @relation(fields: [messageId], references: [id])
  ocrResults    OcrResult[]

  @@index([messageId])
  @@index([downloaded])
}

// ─── OCR Processing ──────────────────────────────────────────────────────────

model OcrResult {
  id               String    @id @default(uuid())
  messageId        String
  imageId          String?

  // Classification
  category         String                  // "fuel" or "repair"
  groupId          String?

  // Extracted data
  extractedData    Json                    // Full extracted JSON
  confidence       Float     @default(0)

  // AI details
  aiModel          String?
  aiPromptTokens   Int?
  aiResponseTokens Int?
  rawAiResponse    String?   @db.Text

  // Review
  status           String    @default("pending")  // pending, confirmed, rejected
  reviewedAt       DateTime?
  reviewNote       String?

  // Telegram notification
  telegramMsgId    Int?                    // Telegram message ID for inline button callbacks
  reminderSentAt   DateTime?              // Last reminder sent time

  // Written to unicon_schedule
  writtenToDb      Boolean   @default(false)
  fuelLogId        String?                 // ID in unicon_schedule.fuel_logs
  repairLogId      String?                 // ID in unicon_schedule.repair_logs

  createdAt        DateTime  @default(now())
  updatedAt        DateTime  @updatedAt

  message          ZaloMessage      @relation(fields: [messageId], references: [id])
  image            ImageAttachment? @relation(fields: [imageId], references: [id])

  @@index([messageId])
  @@index([status])
  @@index([category, status])
}
