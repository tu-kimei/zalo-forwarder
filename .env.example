# Server
PORT=3002
NODE_ENV=development

# Database
DATABASE_URL=postgresql://unicon_user:Unicon@2026@localhost:5432/zalo_forwarder

# Security
JWT_SECRET=change-me-in-production
WEBHOOK_SIGNING_SECRET=change-me-in-production

# Zalo defaults
ZALO_USER_AGENT=Mozilla/5.0 (Windows NT 10.0; Win64; x64) AppleWebKit/537.36 (KHTML, like Gecko) Chrome/120.0.0.0 Safari/537.36
HEALTH_CHECK_INTERVAL_MS=300000

# Webhook defaults
WEBHOOK_RETRY_MAX=3
WEBHOOK_RETRY_DELAY_MS=1000
WEBHOOK_TIMEOUT_MS=10000

# OpenClaw inbound API
OPENCLAW_INBOUND_TOKEN=

# Run as API-only receiver behind OpenClaw OpenZalo
# false => disable internal Zalo websocket listener (recommended)
ENABLE_ZALO_WS_LISTENER=false

# false => disable Telegram getUpdates polling to avoid conflict with OpenClaw Telegram channel
TELEGRAM_ENABLE_POLLING=false
